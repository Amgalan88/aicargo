generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model CargoGroup {
  id     Int     @id @default(autoincrement())
  name   String
  cargos Cargo[]
}

model Cargo {
  id            Int         @id @default(autoincrement())
  name          String
  slug          String      @unique
  ereemReceiver String
  ereemPhone    String
  ereemRegion   String  @default("")
  ereemAddress  String
  // Нэмэлт Эрээний хаягтай карго (жш: "Жижиглэн ачаа", "Бөөн ачаа"): үндсэн хаягийн нэр + бусад хаяг
  ereemTitle     String?
  ereemAddresses Json?
  logoUrl          String?
  lastNotifiedAt        DateTime?
  notificationsEnabled  Boolean    @default(false)
  searchByPhone         Boolean    @default(false)
  aiEnabled         Boolean    @default(false)
  batchEnabled      Boolean    @default(false)
  // Хэрэглэгчээс барааны линкээр захиалга авах (Taobao, Pinduoduo, 1688…)
  linkOrdersEnabled Boolean    @default(false)
  dispatchEnabled   Boolean    @default(true) // «Тулгалт»: «Ирсэн»-ийг Эрээнээс сонгосон ачаатай тулгах — эзэмшигч тохиргооноос унтраана
  phoneVerify       Boolean    @default(false) // ашиглагдахгүй (хуучин: шинэ хэрэглэгч/админы утас шаардах асаалт) — одоо бүртгэл, карго нээлт бүгд утас заавал
  // Брэндбүүкийн загвар (жш "mgl" — Эрээнээс MGL карго): өнгө, фонт, толгойн маршрутын шугам. null = aicargo-ийн энгийн загвар
  brandTheme        String?
  tariff            String?
  priceCubic        Decimal?   @db.Decimal(12, 2)
  priceWeight       Decimal?   @db.Decimal(12, 2)
  priceWeightUnit   String     @default("kg")
  // Жингийн шатлалтай үнэ: JSON [{"min":100,"price":2000}] — min кг-аас дээш бол тухайн үнээр
  priceWeightTiers  String?
  announcement      String?
  contactInfo       String?
  bankName          String?
  bankAccountHolder String?
  bankAccountNumber String?
  bankTransferNote  String?
  arrivedLabel      String?
  ereemLabel        String?
  paidUntil         DateTime?
  createdAt         DateTime   @default(now())
  groupId       Int?
  group         CargoGroup? @relation(fields: [groupId], references: [id])
  users         User[]
  shipments     Shipment[]
  linkOrders    LinkOrder[]
  pushSubscriptions PushSubscription[]
  billingPayments BillingPayment[]
  faqs          Faq[]
  notifications Notification[]
  banners       Banner[]
  batches       Batch[]
  auditLogs     AdminAuditLog[]
  shipmentDeletions ShipmentDeletion[]
  warehouseContracts WarehouseContract[]
  dispatches         Dispatch[]
  loyaltySettings    LoyaltySettings?
  loyaltyAccounts    LoyaltyAccount[]
  loyaltyLedger      LoyaltyLedger[]
  handoverReceipts   HandoverReceipt[]
  priceChanges       ShipmentPriceChange[]
}

model User {
  id           Int        @id @default(autoincrement())
  name         String
  phone        String     @unique
  email        String?    @unique
  password     String
  role         Role       @default(USER)
  cargoId      Int
  cargo        Cargo      @relation(fields: [cargoId], references: [id])
  tokenVersion Int        @default(0)
  isStaffAdmin   Boolean  @default(false)
  canEditBank    Boolean  @default(false)
  canEditAddress Boolean  @default(false)
  canEditLogo    Boolean  @default(false)
  linkOrdersOn   Boolean  @default(false) // хэрэглэгч линк захиалгаа өөрөө асаасан эсэх (карго асаасан байх ёстой)
  phoneVerifiedAt DateTime? // Verify.MN-ээр утсаа баталгаажуулсан цаг
  createdAt    DateTime   @default(now())
  shipments    Shipment[]
  linkOrders   LinkOrder[]
  pushSubscriptions PushSubscription[]
  bannerDismisses      BannerDismiss[]
  superBannerDismisses SuperBannerDismiss[]
  handoverReceipts     HandoverReceipt[]

  @@index([cargoId])
}

model Shipment {
  id             Int       @id @default(autoincrement())
  trackCode      String
  description    String?
  status         Status    @default(REGISTERED)
  userId         Int?
  user           User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  phone          String?
  adminPrice     Decimal?  @db.Decimal(10, 2)
  adminNote      String?
  archived       Boolean   @default(false)
  cargoId        Int
  cargo          Cargo     @relation(fields: [cargoId], references: [id])
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  ereenArrivedAt DateTime?
  arrivedAt      DateTime?
  batchId        Int?
  batch          Batch?    @relation(fields: [batchId], references: [id], onDelete: SetNull)
  // Аль «Олгох» баримтаар олгогдсон (урамшууллын суурь). Хуучин олголтод null
  receiptId      Int?
  receipt        HandoverReceipt? @relation(fields: [receiptId], references: [id], onDelete: SetNull)

  @@unique([trackCode, cargoId])
  @@index([cargoId, status])
  @@index([cargoId, updatedAt])
  @@index([batchId])
  @@index([userId])
  @@index([receiptId])
  @@index([cargoId, phone, status])
}

model Batch {
  id        Int        @id @default(autoincrement())
  cargoId   Int
  cargo     Cargo      @relation(fields: [cargoId], references: [id])
  phone     String
  userId    Int?
  price     Decimal    @db.Decimal(12, 2)
  currency  Currency   @default(MNT)
  note      String?
  status    Status     @default(EREEN_ARRIVED)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  shipments Shipment[]
  logs      BatchLog[]

  @@index([cargoId, status])
  @@index([cargoId, phone])
}

model BatchLog {
  id        Int      @id @default(autoincrement())
  batchId   Int
  batch     Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  userId    Int
  userName  String
  action    String
  detail    String?
  createdAt DateTime @default(now())

  @@index([batchId])
}

model AdminAuditLog {
  id        Int      @id @default(autoincrement())
  cargoId   Int
  cargo     Cargo    @relation(fields: [cargoId], references: [id], onDelete: Cascade)
  userId    Int
  userName  String
  action    String
  detail    String?
  createdAt DateTime @default(now())

  @@index([cargoId, createdAt])
}

// Устгасан ачааны түүх — трак кодоор хайхад "хэзээ, хэн, яаж устгасан" гэдгийг харуулна
model ShipmentDeletion {
  id                Int      @id @default(autoincrement())
  cargoId           Int
  cargo             Cargo    @relation(fields: [cargoId], references: [id], onDelete: Cascade)
  trackCode         String
  phone             String?
  customerName      String?
  description       String?
  status            Status
  ereenArrivedAt    DateTime?
  shipmentCreatedAt DateTime?
  // ereen-single | ereen-by-day | ereen-all | registered
  source            String
  note              String?
  deletedById       Int
  deletedByName     String
  deletedAt         DateTime @default(now())

  @@index([cargoId, trackCode])
  @@index([cargoId, phone])
}

enum Currency {
  MNT
  CNY
}

model Faq {
  id       Int    @id @default(autoincrement())
  question String
  answer   String
  order    Int    @default(0)
  cargoId  Int
  cargo    Cargo  @relation(fields: [cargoId], references: [id])
}

model Notification {
  id         Int          @id @default(autoincrement())
  cargoId    Int
  cargo      Cargo        @relation(fields: [cargoId], references: [id])
  type       NotifType
  title      String
  body       String
  read       Boolean      @default(false)
  archived   Boolean      @default(false)
  createdAt  DateTime     @default(now())

  @@index([cargoId, archived, read])
  @@index([cargoId, archived, createdAt])
}

model Banner {
  id        Int       @id @default(autoincrement())
  cargoId   Int
  cargo     Cargo     @relation(fields: [cargoId], references: [id])
  content   String
  imageUrl  String?
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  dismisses BannerDismiss[]

  @@index([cargoId])
}

model BannerDismiss {
  id        Int      @id @default(autoincrement())
  bannerId  Int
  banner    Banner   @relation(fields: [bannerId], references: [id], onDelete: Cascade)
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([bannerId, userId])
}

model SuperBanner {
  id        Int       @id @default(autoincrement())
  content   String
  imageUrl  String?
  expiresAt DateTime?
  audience  String    @default("ADMIN") // ADMIN | USER | ALL
  createdAt DateTime  @default(now())
  dismisses SuperBannerDismiss[]
}

model SuperBannerDismiss {
  id            Int         @id @default(autoincrement())
  superBannerId Int
  superBanner   SuperBanner @relation(fields: [superBannerId], references: [id], onDelete: Cascade)
  userId        Int
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  @@unique([superBannerId, userId])
}

model PartnerWarehouse {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  phone       String?
  wechat      String?
  address     String?
  imageUrl    String?
  order       Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  slug        String?  @unique
  legalNameMn String?
  legalNameCn String?
  registerNo  String?
  directorName String?
  // Гэрээний төлбөр шууд агуулахын данс руу орно — зөвхөн SUPER_ADMIN засна, нийтэд харуулахгүй
  bankName    String?
  bankAccount String?
  bankHolder  String?
  contractFee Decimal  @default(1200000) @db.Decimal(12, 2)
  services    String?
  pricePerTonCny Decimal? @db.Decimal(12, 2)
  pricePerM3Cny  Decimal? @db.Decimal(12, 2)
  pricePerKgMnt  Decimal? @db.Decimal(12, 2)
  acceptingContracts Boolean @default(true)
  // Гэрээтэй каргод олгох ачаа хүлээн авах хаяг (хятадаар) — хаяг + каргогийн тэмдэг
  receiveRegion  String?
  receiveAddress String?
  receivePhone   String?
  images      WarehouseImage[]
  logs        WarehouseLog[]
  templates   ContractTemplate[]
  contracts   WarehouseContract[]
}

// Гэрээний загвар — хадгалах бүрт шинэ хувилбар; гэрээ нь гарын үсэг зурсан хувилбараа хөлдөөж хадгална
model ContractTemplate {
  id          Int      @id @default(autoincrement())
  warehouseId Int
  warehouse   PartnerWarehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  version     Int
  titleMn     String
  titleCn     String
  // JSON: [{ kind: "text"|"heading"|"clause", no?: "2.1", mn: "...{{x}}...", cn: "...{{x}}..." }]
  body        String
  createdBy   String
  createdAt   DateTime @default(now())
  contracts   WarehouseContract[]

  @@unique([warehouseId, version])
}

enum ContractStatus {
  DRAFT
  AWAITING_PAYMENT
  PAYMENT_REVIEW
  ACTIVE
  TERMINATION_PENDING
  TERMINATED
  REJECTED
}

model WarehouseContract {
  id           Int      @id @default(autoincrement())
  contractNo   String   @unique
  warehouseId  Int
  warehouse    PartnerWarehouse @relation(fields: [warehouseId], references: [id])
  // Нэвтэрсэн каргогийн гэрээнд cargoId; нэвтрэлтгүй (зочны) гэрээнд guestEmail + accessToken
  cargoId      Int?
  cargo        Cargo?   @relation(fields: [cargoId], references: [id])
  guestEmail   String?
  accessToken  String?  @unique
  templateId   Int
  template     ContractTemplate @relation(fields: [templateId], references: [id])
  status       ContractStatus @default(DRAFT)
  // JSON: каргогийн бөглөсөн талбарууд
  values       String   @default("{}")
  // Гарын үсэг зурсан мөчийн хөлдөөсөн гэрээ (JSON) ба түүний sha256
  renderedBody String?
  bodyHash     String?
  fee          Decimal  @db.Decimal(12, 2)
  payToBank    String?
  payToAccount String?
  payToHolder  String?
  paymentProofUrl  String?
  paymentNote      String?
  paymentClaimedAt DateTime?
  paidAt           DateTime?
  cargoSignedAt   DateTime?
  cargoSignerId   Int?
  cargoSignerName String?
  cargoSignerEmail String?
  cargoSignIp     String?
  approvedAt      DateTime?
  approvedById    Int?
  approvedByName  String?
  warehouseNote   String?
  rejectReason    String?
  terminationRequestedAt DateTime?
  terminationRequestedBy String?
  terminationReason      String?
  terminationEffectiveAt DateTime?
  terminatedAt    DateTime?
  // Гэрээ хүчин төгөлдөр болоход каргод олгосон 60 хоногийн үнэгүй вэбсайт — нэг гэрээнд нэг удаа
  websiteBonusAt  DateTime?
  // Агуулах ачааг ялгах каргогийн тэмдэг (жш: B88) — хүчинтэй гэрээнүүдэд агуулах бүрт давхцахгүй
  cargoMark       String?
  createdById     Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  events          ContractEvent[]

  @@index([cargoId, status])
  @@index([warehouseId, status])
  @@index([status, updatedAt])
  @@index([guestEmail])
}

model ContractEvent {
  id         Int      @id @default(autoincrement())
  contractId Int
  contract   WarehouseContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  actorId    Int?
  actorName  String
  action     String
  detail     String?
  createdAt  DateTime @default(now())

  @@index([contractId, createdAt])
}

// Агуулахын тохиргооны өөрчлөлт (ялангуяа данс) — AdminAuditLog нь cargoId шаарддаг тул тусдаа
model WarehouseLog {
  id          Int      @id @default(autoincrement())
  warehouseId Int
  warehouse   PartnerWarehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  userId      Int
  userName    String
  action      String
  detail      String?
  createdAt   DateTime @default(now())

  @@index([warehouseId, createdAt])
}

model WarehouseImage {
  id          Int      @id @default(autoincrement())
  warehouseId Int
  warehouse   PartnerWarehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  url         String
  publicId    String
  caption     String?
  category    String   @default("GENERAL") // EXTERIOR | INTERIOR | PACKING | LOADING | GENERAL
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([warehouseId, order])
}

model AiTraining {
  id        Int      @id @default(autoincrement())
  question  String
  answer    String
  active    Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model AiConfig {
  id          Int    @id @default(1)
  userPrompt  String @default("")
  adminPrompt String @default("")
}

model Otp {
  id        Int      @id @default(autoincrement())
  email     String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
}

enum NotifType {
  NEW_SHIPMENT
  CROSS_CARGO
}

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
  EREEN
}

enum Status {
  REGISTERED
  EREEN_ARRIVED
  ARRIVED
  PICKED_UP
}

// Хэрэглэгчийн илгээсэн барааны линк — карго үнэ тооцож, төлбөр орсны дараа захиалж өгнө.
// status: NEW (шинэ) → QUOTED (үнэ илгээсэн) → PAID (төлбөр орсон) → ORDERED (захиалсан); CANCELLED (цуцалсан)
model LinkOrder {
  id         Int       @id @default(autoincrement())
  cargoId    Int
  cargo      Cargo     @relation(fields: [cargoId], references: [id], onDelete: Cascade)
  userId     Int?
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  name       String
  phone      String
  url        String
  quantity   Int       @default(1)
  note       String?
  // Хэрэглэгчийн сонгосон өнгө/хэмжээний зураг (заавал биш)
  imageUrl   String?
  status     String    @default("NEW")
  price      Decimal?  @db.Decimal(12, 2)
  paidAmount Decimal?  @db.Decimal(12, 2)
  paidAt     DateTime?
  quotedAt   DateTime?
  orderedAt  DateTime?
  trackCode  String?
  adminNote  String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([cargoId, status])
  @@index([cargoId, createdAt])
  @@index([userId])
}

// Web push — хэрэглэгчийн төхөөрөмж бүрийн бүртгэл (утас, компьютер тус тусдаа)
model PushSubscription {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cargoId   Int
  cargo     Cargo    @relation(fields: [cargoId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([cargoId])
}

// Вэбсайтын төлбөр Byl-ээр (QPay, SocialPay…). Нэхэмжлэх бүр нэг мөр — нэг төлбөрөөр давхар сунгахгүй
model BillingPayment {
  id              Int       @id @default(autoincrement())
  cargoId         Int
  cargo           Cargo     @relation(fields: [cargoId], references: [id], onDelete: Cascade)
  periods         Int
  amount          Decimal   @db.Decimal(12, 2)
  status          String    @default("PENDING") // PENDING → PAID
  bylInvoiceId    Int?      @unique
  url             String?
  createdById     Int?
  createdByName   String?
  paidAt          DateTime?
  paidUntilBefore DateTime?
  paidUntilAfter  DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt

  @@index([cargoId, createdAt])
}

// Verify.MN утас баталгаажуулалт (хэрэглэгч 144773 руу кодоо SMS-ээр илгээнэ)
model PhoneVerification {
  id         String    @id
  phone      String
  purpose    String    @default("signup") // нэг баталгаажуулалт нэг зорилгод л хэрэглэгдэнэ
  code       String
  sessionId  String    @unique // Verify.MN-ийн session id — нууц, хөтөч рүү хэзээ ч илгээхгүй
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  verifiedAt DateTime?
  usedAt     DateTime? // нэг баталгаажуулалт = нэг бүртгэл

  @@index([phone, createdAt])
}

// Ачилт — Эрээнээс нэг машинд ачигдсан бөөн код (агуулахын жагсаалт, жш «11月1号» 96 код).
// «Ирсэн» бүртгэлийг ачилтаар нь хийж ирсэн / ирээгүй / илүүг тулгана. Ачааны хүснэгтэд хүрэхгүй — код + төлөвөөр тооцно.
model Dispatch {
  id            Int            @id @default(autoincrement())
  cargoId       Int
  cargo         Cargo          @relation(fields: [cargoId], references: [id], onDelete: Cascade)
  date          DateTime       // ачигдсан өдөр (УБ 12:00)
  name          String?
  closedAt      DateTime?
  createdById   Int
  createdByName String
  createdAt     DateTime       @default(now())
  items         DispatchItem[]

  @@index([cargoId, date])
}

model DispatchItem {
  id         Int      @id @default(autoincrement())
  dispatchId Int
  dispatch   Dispatch @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  trackCode  String
  // true — ачилтын жагсаалтад байгаагүй атлаа энэ ачилтаар «Ирсэн» бүртгэгдсэн (илүү)
  extra      Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@unique([dispatchId, trackCode])
  @@index([trackCode])
}

// ── Урамшуулал (Карго оноо · VIP хөнгөлөлт) ─────────────────────────────────
// Карго бүр өөрөө асаана; мөр байхгүй = хоёр горим унтраалттай (одоогийн ажиллагаа хэвээр)
model LoyaltySettings {
  cargoId          Int      @id
  cargo            Cargo    @relation(fields: [cargoId], references: [id], onDelete: Cascade)
  pointsEnabled    Boolean  @default(false)
  vipEnabled       Boolean  @default(false)
  // Оноо: ₮earnMntPerPoint төлөхөд 1 оноо; 1 оноо = ₮pointValueMnt
  earnMntPerPoint  Int      @default(1000)
  pointValueMnt    Int      @default(20)
  pointsExpiryDays Int      @default(180)
  maxRedeemPct     Int      @default(50)
  // VIP: сүүлийн vipWindowDays хоногийн олгосон дүнгээр шат; шат буурахад vipGraceDays хоног хадгална
  vipWindowDays    Int      @default(90)
  vipGraceDays     Int      @default(30)
  // [{"minSpend":90000,"pct":1},...] — pct 1..5
  vipTiers         Json
  updatedById      Int?
  updatedByName    String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// Хэрэглэгчийн урамшууллын данс — түлхүүр нь (cargoId, phone). Бүртгэлгүй утсанд ч оноо хуримтлагдана
model LoyaltyAccount {
  id              Int             @id @default(autoincrement())
  cargoId         Int
  cargo           Cargo           @relation(fields: [cargoId], references: [id], onDelete: Cascade)
  phone           String
  // Гараар оноосон VIP % (1..5). Автомат шатаас өндөр бол үйлчилнэ
  vipManualPct    Int?
  vipManualNote   String?
  vipManualUntil  DateTime?
  vipManualById   Int?
  vipManualByName String?
  vipManualAt     DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  ledger          LoyaltyLedger[]

  @@unique([cargoId, phone])
  @@index([cargoId, vipManualPct])
}

// Онооны дэвтэр — зөвхөн нэмж бичнэ (DB trigger UPDATE/DELETE-ийг хориглоно). Залруулга = шинэ ADJUST мөр
// kind: EARN (+) · REDEEM (−) · ADJUST (±, олгосны дараа үнэ зассан) · EXPIRE (−, хугацаа дууссан)
//       VOID (±, олголтыг буцаасан: олсон оноог хасна (−), зарцуулсан оноог буцаана (+))
model LoyaltyLedger {
  id            Int              @id @default(autoincrement())
  cargoId       Int
  cargo         Cargo            @relation(fields: [cargoId], references: [id], onDelete: Cascade)
  accountId     Int
  account       LoyaltyAccount   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  kind          String
  points        Int
  // EARN/ADJUST(+) мөрийн дуусах огноо
  expiresAt     DateTime?
  receiptId     Int?
  receipt       HandoverReceipt? @relation(fields: [receiptId], references: [id], onDelete: NoAction)
  priceChangeId Int?
  // EXPIRE аль EARN/ADJUST мөрийг дуусгасан
  refLedgerId   Int?
  // Давхар бичихээс хамгаална: earn:r<id> · redeem:r<id> · adj:pc<id> · expire:l<id>
  dedupeKey     String           @unique
  note          String?
  actorId       Int?
  actorName     String?
  createdAt     DateTime         @default(now())

  @@index([cargoId, accountId, createdAt])
  @@index([cargoId, createdAt])
  @@index([receiptId])
}

// «Олгох» баримт — нэг олголт, нэг утас = нэг мөр (олголттой нэг транзакцид). Дүнгүүд нь тухайн мөчийн хуулбар
model HandoverReceipt {
  id                Int             @id @default(autoincrement())
  cargoId           Int
  cargo             Cargo           @relation(fields: [cargoId], references: [id], onDelete: Cascade)
  // Нэг «Олгох» дарах хүсэлтийн түлхүүр — дахин илгээхэд давхар баримт үүсэхгүй
  requestKey        String
  // Утас эсвэл '' (утасгүй ачаа)
  ownerKey          String
  phone             String?
  userId            Int?
  user              User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  itemCount         Int
  // [{"id":1,"trackCode":"..","price":3000}]
  items             Json
  grossMnt          Decimal         @db.Decimal(12, 2)
  vipEnabled        Boolean         @default(false)
  vipPct            Int             @default(0)
  vipSource         String?
  vipDiscountMnt    Decimal         @default(0) @db.Decimal(12, 2)
  pointsEnabled     Boolean         @default(false)
  pointsRedeemed    Int             @default(0)
  pointsRedeemedMnt Decimal         @default(0) @db.Decimal(12, 2)
  pointsEarned      Int             @default(0)
  earnMntPerPoint   Int?
  pointValueMnt     Int?
  netMnt            Decimal         @db.Decimal(12, 2)
  // Урамшуулал хэрэглээгүй шалтгаан (жш: self — админ өөрийн утсанд олгосон)
  loyaltyNote       String?
  createdById       Int
  createdByName     String
  createdAt         DateTime        @default(now())
  // «Ирсэн төлөвт буцаах» (түүх) — баримт цуцлагдсан: тайлан, VIP зарцуулалтад тооцогдохгүй, оноо VOID мөрөөр буцаагдсан
  voidedAt          DateTime?
  voidedById        Int?
  voidedByName      String?
  shipments         Shipment[]
  ledger            LoyaltyLedger[]

  @@unique([cargoId, requestKey, ownerKey])
  @@index([cargoId, createdAt])
  @@index([cargoId, phone, createdAt])
}

// Ачааны үнийн (adminPrice) өөрчлөлтийн түүх. Олгосон ачааны үнэ засвал хөнгөлөлт/онооны зөрүүг энд бичнэ
model ShipmentPriceChange {
  id                  Int      @id @default(autoincrement())
  cargoId             Int
  cargo               Cargo    @relation(fields: [cargoId], references: [id], onDelete: Cascade)
  shipmentId          Int
  trackCode           String
  status              Status
  oldPrice            Decimal? @db.Decimal(10, 2)
  newPrice            Decimal? @db.Decimal(10, 2)
  receiptId           Int?
  vipDiscountDeltaMnt Decimal  @default(0) @db.Decimal(12, 2)
  pointsDelta         Int      @default(0)
  actorId             Int
  actorName           String
  createdAt           DateTime @default(now())

  @@index([cargoId, createdAt])
  @@index([receiptId])
  @@index([cargoId, shipmentId])
}
