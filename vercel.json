{
  "regions": [
    "bom1"
  ],
  "functions": {
    "app/api/manychat/wake/route.ts": {
      "maxDuration": 15,
      "experimentalTriggers": [
        { "type": "queue/v2beta", "topic": "manychat-gateway-wake" }
      ]
    }
  },
  "crons": [
    {
      "path": "/api/cron/demo-reset",
      "schedule": "0 20 * * *"
    },
    {
      "path": "/api/cron/push-flush",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/manychat-recover",
      "schedule": "30 20 * * *"
    }
  ]
}
